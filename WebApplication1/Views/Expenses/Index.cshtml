@model IEnumerable<FinanceManager.Models.Expense>

@{
    ViewData["Title"] = "Мої Витрати";
}

<h1>Мої Витрати</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchTerm" class="form-control" placeholder="Пошук..." value="@ViewBag.CurrentSearch" />
            <button type="submit" class="btn btn-primary">Знайти</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
        </form>
    </div>
</div>
@if (!string.IsNullOrEmpty(ViewBag.CurrentCategory as string))
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>
            🔍 Показано тільки категорію: <strong>@ViewBag.CurrentCategory</strong>
        </span>
        <a asp-action="Index" class="btn btn-sm btn-outline-dark">Скинути фільтр ✕</a>
    </div>
}
<p>
    <a asp-action="Create" class="btn btn-success">Додати нову витрату +</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Опис</th>
            <th>Категорія</th>
            <th>Дата</th>
            <th>
                Сума
                <a asp-action="Index" asp-route-sortOrder="amount_asc" class="btn btn-sm btn-light border ms-1">⬆</a>
            </th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @* --- ПОЧАТОК БЕЗПЕЧНОГО БЛОКУ --- *@
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>
                        <a asp-action="Index" asp-route-category="@item.Category" class="text-decoration-none">
                            <span class="badge bg-info text-dark">@item.Category</span>
                        </a>
                    </td>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.Amount.ToString("C")</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                              onsubmit="return confirm('Ви впевнені, що хочете видалити цей запис?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                🗑️ Видалити
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-danger fw-bold">
                    ⚠️ УВАГА: Список витрат не отримано (Model is null).<br />
                    Спробуйте перезібрати проект (Build -> Rebuild Solution).
                </td>
            </tr>
        }
        @* --- КІНЕЦЬ БЕЗПЕЧНОГО БЛОКУ --- *@
    </tbody>
</table>